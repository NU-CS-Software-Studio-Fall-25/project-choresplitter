<% content_for :title, "Bills – Choresplitter" %>

<div class="container-fluid" style="margin-top: 40px;">
  <!-- Page Heading -->
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center">
      <h1 class="h3 text-gray-800 mb-0">
        Bills
        <% if @chore_group %>
          <small class="text-muted" style="font-size:.7em;">
            &nbsp;in <%= @chore_group.name %>
          </small>
        <% else %>
          <small class="text-muted" style="font-size:.7em;">
            &nbsp;(All groups)
          </small>
        <% end %>
      </h1>

      <div class="ml-3">
        <%= form_with url: bills_path, method: :get, local: true, class: "form-inline" do %>
          <%= select_tag :chore_group_id,
              options_for_select(
                [["All groups", ""]] +
                (@user_groups || []).map { |g| [g.name, g.code] },
                params[:chore_group_id]
              ),
              class: "form-control form-control-sm",
              onchange: "this.form.submit();" %>

          <% if params[:from].present? %>
            <%= hidden_field_tag :from, params[:from] %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div>
      <% if @chore_group %>
        <%= link_to "Create Bill",
            new_chore_group_bill_path(@chore_group),
            class: "d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm" %>
      <% else %>
        <button class="d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm" disabled>
          Select a group to create bill
        </button>
      <% end %>
    </div>
  </div>

  <% if params[:from] == "group" && @chore_group.present? %>
    <div class="mb-2">
      <%= link_to "← Back to Group: #{@chore_group.name}",
          chore_group_path(@chore_group),
          class: "btn btn-link btn-sm p-0" %>
    </div>
  <% end %>

  <%# --- Stats Cards --- %>
  <div class="row">
    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-primary shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">You Paid (Total)</div>
              <div class="h5 mb-0 font-weight-bold text-gray-800"><%= number_to_currency(@total_you_paid || 0) %></div>
            </div>
            <div class="col-auto"><i class="fas fa-wallet fa-2x text-gray-300"></i></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-success shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Others Owe You (Net)</div>
              <div class="h5 mb-0 font-weight-bold text-gray-800"><%= number_to_currency(@you_are_creditor_unpaid || 0) %></div>
            </div>
            <div class="col-auto"><i class="fas fa-hand-holding-usd fa-2x text-gray-300"></i></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-warning shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">You Owe (Net)</div>
              <div class="h5 mb-0 font-weight-bold text-gray-800"><%= number_to_currency(@you_owe_unpaid || 0) %></div>
            </div>
            <div class="col-auto"><i class="fas fa-exclamation-circle fa-2x text-gray-300"></i></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-info shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Involved Bills</div>
              <div class="h5 mb-0 font-weight-bold text-gray-800"><%= @involved_count || 0 %></div>
            </div>
            <div class="col-auto"><i class="fas fa-receipt fa-2x text-gray-300"></i></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# --- Net Balances Dashboard (Settle Up Area) --- %>
  <% if @chore_group && @member_balances.present? %>
    <div class="row mb-4">
      <div class="col-12">
        <h6 class="font-weight-bold text-gray-800">Balances</h6>
        <div class="card shadow-sm">
          <ul class="list-group list-group-flush">
            <% @member_balances.each do |item| %>
              <% member = item[:member] %>
              <% balance = item[:balance] %>
              
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                  <div class="mr-3">
                    <div class="rounded-circle bg-gray-200 d-flex align-items-center justify-content-center text-primary font-weight-bold" style="width:40px;height:40px;">
                      <%= member.name.first.upcase rescue '?' %>
                    </div>
                  </div>
                  <div>
                    <h6 class="mb-0"><%= member.name || member.user&.name || "Member##{member.id}" %></h6>
                    <% if balance > 0 %>
                      <small class="text-success font-weight-bold">owes you <%= number_to_currency(balance) %></small>
                    <% else %>
                      <small class="text-danger font-weight-bold">you owe <%= number_to_currency(balance.abs) %></small>
                    <% end %>
                  </div>
                </div>

                <div>
                  <% if balance > 0 %>
                    <button type="button" class="btn btn-sm btn-success" data-toggle="modal" data-target="#settleModal_<%= member.id %>">
                      Settle Up
                    </button>

                    <div class="modal fade" id="settleModal_<%= member.id %>" tabindex="-1" role="dialog">
                      <div class="modal-dialog" role="document">
                        <div class="modal-content">
                          <%= form_with url: chore_group_payments_path(@chore_group), scope: :payment, local: true do |f| %>
                            <div class="modal-header">
                              <h5 class="modal-title">Settle Up with <%= member.name %></h5>
                              <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                            </div>
                            <div class="modal-body">
                              <p>Did you receive payment from <strong><%= member.name %></strong>?</p>
                              <%= f.hidden_field :payer_id, value: member.id %> 
                              <%= f.hidden_field :payee_id, value: @current_member.id %> 
                              <div class="form-group">
                                <label>Amount Received</label>
                                <div class="input-group">
                                  <div class="input-group-prepend"><span class="input-group-text">$</span></div>
                                  <%= f.number_field :amount, value: balance, step: 0.01, min: 0.01, class: "form-control" %>
                                </div>
                              </div>
                            </div>
                            <div class="modal-footer">
                              <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                              <%= f.submit "Record Payment", class: "btn btn-success" %>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </div>

                  <% elsif balance < 0 %>
                    <button class="btn btn-sm btn-outline-secondary" disabled>
                      You owe
                    </button>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="row">
    <%# --- Left Column: BILL TRANSACTIONS (Merged List) --- %>
    <div class="col-lg-6">
      <div class="card shadow mb-4">
        <div class="card-header py-3">
          <h6 class="m-0 font-weight-bold text-primary">Bill Transactions</h6>
        </div>
        <div class="card-body">
          <% if (@bills_you_paid.blank? && @your_shares.blank?) %>
            <div class="text-muted text-center py-3">No bills yet.</div>
          <% else %>
            
            <%# Section 1: Bills You Paid %>
            <% if @bills_you_paid.any? %>
              <div class="mb-2"><small class="text-uppercase font-weight-bold text-gray-500 border-bottom pb-1 d-block">You Paid</small></div>
              <% @bills_you_paid.each do |bill| %>
                <div class="mb-3 pb-2 border-bottom">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <strong><%= bill.description %></strong>
                      <div class="small text-muted">
                        <%= l(bill.created_at, format: :short) rescue bill.created_at.to_s %>
                        · Total: <%= number_to_currency(bill.total_amount) %>
                      </div>
                    </div>
                    <div>
                      <%= link_to "Details", bill_path(bill), class: "btn btn-sm btn-outline-secondary" %>
                    </div>
                  </div>
                  <div class="small text-muted mt-1">
                     Split with: 
                     <% if bill.bill_shares.any? %>
                        <%= bill.bill_shares.map{|s| s.member.name || s.member.user&.email_address || "Member##{s.member_id}"}.join(", ") %>
                     <% else %>
                        Only you
                     <% end %>
                  </div>
                </div>
              <% end %>
              <div class="mt-2 mb-4 d-flex justify-content-center">
                <%== @pagy_paid.series_nav(:bootstrap) %>
              </div>
            <% end %>

            <%# Section 2: Bills You Owe %>
            <% if @your_shares.any? %>
              <div class="mb-2"><small class="text-uppercase font-weight-bold text-gray-500 border-bottom pb-1 d-block">You Owe (Your Shares)</small></div>
              <% @your_shares.each do |share| %>
                <% bill = share.bill %>
                <div class="mb-3 pb-2 border-bottom">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <strong><%= bill.description %></strong>
                      <div class="small text-muted">
                        Payer: <%= bill.member&.name || bill.member.user&.email_address %>
                        · Share: <%= number_to_currency(share.amount) %>
                        · <%= l(bill.created_at, format: :short) rescue bill.created_at.to_s %>
                      </div>
                    </div>
                    <div>
                      <%= link_to "Details", bill_path(bill), class: "btn btn-sm btn-outline-secondary" %>
                    </div>
                  </div>
                </div>
              <% end %>
              <div class="mt-2 d-flex justify-content-center">
                <%== @pagy_owed.series_nav(:bootstrap) %>
              </div>
            <% end %>
            
          <% end %>
        </div>
      </div>
    </div>

    <%# --- Right Column: PAYMENT HISTORY (Settlements) --- %>
    <div class="col-lg-6">
      <div class="card shadow mb-4">
        <div class="card-header py-3">
          <h6 class="m-0 font-weight-bold text-success">Settlement History</h6>
        </div>
        <div class="card-body">
          <% if @payments && @payments.any? %>
            <ul class="list-group list-group-flush">
              <% @payments.each do |payment| %>
                <% 
                   current_uid = Current.user.id
                   # Safe navigation in case payer/payee or their user is missing (though constraints should prevent this)
                   payer_uid = payment.payer&.user_id
                   
                   is_payer = (payer_uid == current_uid)
                %>
                
                <li class="list-group-item d-flex justify-content-between align-items-center pl-0 pr-0">
                  <div>
                    <% if is_payer %>
                      <span class="text-danger font-weight-bold">You paid</span>
                      <%= payment.payee.name || "Member##{payment.payee_id}" %>
                    <% else %>
                      <%= payment.payer.name || "Member##{payment.payer_id}" %>
                      <span class="text-success font-weight-bold">paid you</span>
                    <% end %>
                    <div class="small text-muted">
                      <%= l(payment.created_at, format: :short) rescue payment.created_at.to_s %>
                    </div>
                  </div>
                  <div class="font-weight-bold">
                    <%= number_to_currency(payment.amount) %>
                  </div>
                </li>
              <% end %>
            </ul>
            
            <%# --- Payments Pagination --- %>
            <div class="mt-3 d-flex justify-content-center">
              <% if @pagy_payments %>
                <%== @pagy_payments.series_nav(:bootstrap) %>
              <% end %>
            </div>

          <% else %>
            <div class="text-muted text-center py-4">
              No settlement records found.
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

</div>