<% content_for :title, "Create Bill – Choresplitter" %>

<div class="container-fluid">
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 text-gray-800 mb-0">Create New Bill</h1>
    <a href="<%= bills_path rescue '#' %>" class="d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm">
      <i class="fas fa-list fa-sm text-white-50"></i> Back to Bills
    </a>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
          <h6 class="m-0 font-weight-bold text-primary">Bill Details</h6>
        </div>
        <div class="card-body">
          <form onsubmit="event.preventDefault();">
            <input type="hidden" name="bill[chore_group_id]" value="1">
            <input type="hidden" name="bill[member_id]" value="3">

            <div class="form-group">
              <label class="small mb-1 text-gray-700">Description</label>
              <input type="text" class="form-control" placeholder="e.g., Dinner at Sakura" required>
            </div>

            <div class="form-group">
              <label class="small mb-1 text-gray-700">Total Amount</label>
              <div class="input-group">
                <div class="input-group-prepend"><span class="input-group-text">$</span></div>
                <input id="bill_total" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00">
              </div>
              <small class="form-text text-muted">
                Will be split equally among selected members (payer included).
              </small>
            </div>

            <div class="form-group">
              <label class="small mb-2 text-gray-700">Participants</label>
              <div class="card border-left-primary">
                <div class="card-body py-2">
                  <div class="row">
                    <div class="col-6 col-md-4 mb-2">
                      <div class="custom-control custom-checkbox">
                        <input class="custom-control-input split-member" type="checkbox" id="member_1" value="1" checked>
                        <label class="custom-control-label" for="member_1">Alice</label>
                      </div>
                    </div>
                    <div class="col-6 col-md-4 mb-2">
                      <div class="custom-control custom-checkbox">
                        <input class="custom-control-input split-member" type="checkbox" id="member_2" value="2" checked>
                        <label class="custom-control-label" for="member_2">Bob</label>
                      </div>
                    </div>
                    <div class="col-6 col-md-4 mb-2">
                      <div class="custom-control custom-checkbox">
                        <input class="custom-control-input" type="checkbox" id="member_3" value="3" disabled>
                        <label class="custom-control-label" for="member_3">Charlie <span class="badge badge-light ml-1">you</span></label>
                      </div>
                    </div>
                  </div>
                  <div class="mt-2">
                    <button class="btn btn-sm btn-outline-secondary" id="toggle-select-others" type="button">
                      Toggle Select Others
                    </button>
                  </div>
                </div>
              </div>

              <div class="mt-2 small text-muted" id="split-preview">
                Selected: <span id="selected-count">0</span> people (excluding you).
                &nbsp;Each pays: <strong>$<span id="each-amount">0.00</span></strong>
              </div>
            </div>

            <div class="d-flex">
              <button type="submit" class="btn btn-primary mr-2">Create Bill</button>
              <a href="<%= bills_path rescue '#' %>" class="btn btn-light">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card shadow mb-4">
        <div class="card-header py-3">
          <h6 class="m-0 font-weight-bold text-primary">How splitting works</h6>
        </div>
        <div class="card-body small text-gray-700">
          <ul class="mb-0 pl-3">
            <li>Payer (you) is always included in the split.</li>
            <li>Each share = Total ÷ (selected others + 1 payer).</li>
            <li>Uncheck members who didn’t participate.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  const meId = 3;
  function updatePreview() {
    const totalEl = document.getElementById('bill_total');
    const boxes = Array.from(document.querySelectorAll('.split-member'));
    const total = parseFloat(totalEl && totalEl.value) || 0;
    const selectedOthers = boxes.filter(b => b.checked && parseInt(b.value) !== meId).length;
    const people = selectedOthers + 1;
    const each = people > 0 ? (total / people) : 0;
    document.getElementById('selected-count').innerText = selectedOthers;
    document.getElementById('each-amount').innerText = each.toFixed(2);
  }
  document.addEventListener('input', e => {
    if (e.target.matches('#bill_total, .split-member')) updatePreview();
  });
  const toggleBtn = document.getElementById('toggle-select-others');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const boxes = Array.from(document.querySelectorAll('.split-member'));
      const others = boxes.filter(b => parseInt(b.value) !== meId);
      const checkedCount = others.filter(b => b.checked).length;
      const targetState = checkedCount < (others.length / 2);
      others.forEach(b => b.checked = targetState);
      updatePreview();
    });
  }
  document.addEventListener('DOMContentLoaded', updatePreview);
})();
</script>
