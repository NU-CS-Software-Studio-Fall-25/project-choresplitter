<div id="content" class="p-5">
    <h2 style="color:#000; border-bottom:1px solid #757575ff; padding-bottom:15px; margin-top:10px;">Invitations Inbox</h2>

    <% if @invitations.any? %>
    <table style="width:100%; border-collapse:collapse; margin-top:12px;">
        <thead>
        <tr>
            <th style="text-align:left; padding:8px; border-bottom:1px solid #eee;">Group</th>
            <th style="text-align:left; padding:8px; border-bottom:1px solid #eee;">From</th>
            <th style="text-align:left; padding:8px; border-bottom:1px solid #eee;">Status</th>
            <th style="padding:8px; border-bottom:1px solid #eee;">Actions</th>
        </tr>
        </thead>
        <tbody>
        <% @invitations.each do |inv| %>
            <tr>
            <td style="padding:8px; border-bottom:1px solid #f5f5f5;">
                <%= inv.chore_group.name %>
            </td>
            <td style="padding:8px; border-bottom:1px solid #f5f5f5;">
                <%= inv.sender.try(:email_address) || "Unknown" %>
            </td>
            <td style="padding:8px; border-bottom:1px solid #f5f5f5;">
                <%= inv.status.capitalize %>
            </td>
            <td style="padding:8px; border-bottom:1px solid #f5f5f5; text-align:center;">
                <% if inv.status == "pending" %>
                <%= button_to "Accept",
                        invitation_path(inv, decision: "accept"),
                        method: :patch,
                        form: { style: "display:inline" } %>

                <%= button_to "Decline",
                        invitation_path(inv, decision: "decline"),
                        method: :patch,
                        form: { style: "display:inline; margin-left:6px;" } %>
                <% else %>
                <span style="font-size:12px; color:#6b7280;">No actions</span>
                <% end %>
            </td>
            </tr>
        <% end %>
        </tbody>
    </table>
    <% else %>
    <p>No invitations at the moment.</p>
    <% end %>
</div>