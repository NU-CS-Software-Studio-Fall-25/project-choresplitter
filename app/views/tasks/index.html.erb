<h2>All tasks</h2>
<div class="d-flex flex-column">
  <ul class="list-group">
    <% @tasks.each do |t| %>
      <li class="list-group-item"><%= t.title%></li> 
      <li class="list-group-item"><%= t.description%></li> 
      <li class="list-group-item"><%= t.member_id%></li> 
      <li class="list-group-item"><%= t.task_group_id%></li> 
      <li class="list-group-item"><%= t.created_at%></li> 
      <li class="list-group-item"><%= t.updated_at%></li> 
    <% end %>
  </ul>
</div>
