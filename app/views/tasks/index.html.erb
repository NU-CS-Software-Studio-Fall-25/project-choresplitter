<div style="padding: 5% 2%;
    color: #343434;">
  <h2 class="pb-3">My Tasks</h2>
  <% @tasks.each do |task| %>
    <div class="card mb-3 p-3 border-dark">
      <h5><%= task.title %></h5>

      <% if task.description.present? %>
        <p><%= task.description %></p>
      <% end %>

      <small>
        Group: 
        <%= task.task_group.chore_group.name %><br>
      </small>
    </div>
  <% end %>
</div>