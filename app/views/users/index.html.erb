<h2>My Chore Groups</h2>

<% if @chore_groups.any? %>
  <ul>
    <% @chore_groups.each do |group| %>
      <li>
        <strong>Name:</strong> <%= group.name %><br>
        # <strong>ID:</strong> <%= group.id %><br>
        # <strong>Admin:</strong> <%= group.admin&.name || "(none)" %>
         <strong>Name:</strong> <%= group.admin_id %><br>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>This user is not in any chore groups yet.</p>
<% end %>