<div id="content" class="p-5">
  <h2 style="color: #000000ff; border-bottom: 1px solid #757575ff; padding-bottom: 15px; margin-top: 10px;">
    My Chore Groups
  </h2>

  <% if @chore_groups.any? %>
    <ul style="list-style-type: none; margin: 0; padding: 0;">
      <% @chore_groups.each do |group| %>
        <li style="padding: 15px 5px; border-bottom: 1px solid #757575ff; display:flex; align-items:center; justify-content:space-between; gap:12px;">
          <div>
            <strong style="color: #000000ff; display: inline-block; width: 100px;">Name:</strong> <%= group.name %><br>
            <strong style="color: #000000ff; display: inline-block; width: 100px;">Admin ID:</strong> <%= group.admin_id %>
          </div>

          <%= link_to "View group", chore_group_path(group),
                style: "padding:8px 12px; border:1px solid #9d9d9dff; border-radius:6px; text-decoration:none; background:#f5f5f5; color:#333; font-weight:600;" %>
        </li>
      <% end %>
    </ul>
    <div class="py-4">
       <%=  @pagy.series_nav(:bootstrap).html_safe%>
    <div>
  <% else %>
    <p style="color: #000000ff; background-color: #f9f9f9; padding: 20px; text-align: center; border-radius: 4px;">
      This user is not in any chore groups yet.
    </p>
     <div class="py-4">
       <%=  @pagy.series_nav(:bootstrap).html_safe%>
    <div>
  <% end %>

</div>