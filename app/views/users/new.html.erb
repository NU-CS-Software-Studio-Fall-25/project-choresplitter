<div style="background-color: white; padding: 40px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); width: 100%; max-width: 600px; margin: 40px auto; font-family: sans-serif;">
  <h1 style="color: #333; border-bottom: 1px solid #eee; padding-bottom: 15px; margin-top: 0; margin-bottom: 30px;">
    Sign Up
  </h1>

  <%= form_with(model: @user, local: true) do |form| %>
    <% if @user.errors.any? %>
      <div style="color: #dc3545; margin-bottom: 20px;">
        <h2><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h2>
        <ul>
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="margin-bottom: 20px;">
      <%= form.label :email_address, style: "display: block; margin-bottom: 8px; color: #555; font-weight: 500;" %>
      <%= form.email_field :email_address, required: true,
            style: "width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; font-size: 16px;" %>
    </div>

    <div style="margin-bottom: 20px;">
      <%= form.label :password, style: "display: block; margin-bottom: 8px; color: #555; font-weight: 500;" %>
      <%= form.password_field :password, required: true,
            style: "width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; font-size: 16px;" %>
    </div>

    <div style="margin-bottom: 20px;">
      <%= form.label :password_confirmation, style: "display: block; margin-bottom: 8px; color: #555; font-weight: 500;" %>
      <%= form.password_field :password_confirmation, required: true,
            style: "width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; font-size: 16px;" %>
    </div>

    <div style="margin-top: 30px;">
      <%= form.submit "Sign Up", 
            style: "width: 100%; padding: 12px; background-color: #007bff; color: white; border: none; border-radius: 4px; font-size: 16px; font-weight: bold; cursor: pointer;" %>
    </div>
  <% end %>

  <div style="text-align: center; margin-top: 20px;">
    <%= link_to "Already have an account? Sign in", new_session_path, style: "color: #007bff; text-decoration: none;" %>
  </div>
</div>