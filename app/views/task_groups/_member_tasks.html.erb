<div style="margin-top:8px;">
  <h3 style="margin:0 0 12px;">My Tasks</h3>

  <% if @my_tasks.present? %>
    <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:10px;">
      <% @my_tasks.each do |t| %>
        <li style="border:1px solid #eee; border-radius:8px; padding:10px; display:flex; justify-content:space-between; gap:12px;">
          <div style="min-width:0;">
            <div style="font-weight:700;"><%= t.title %></div>
            <% if t.description.present? %>
              <div style="color:#555; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= t.description %></div>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>

    <div style="margin-top:12px;">
      <%# Use whatever Pagy helper you enabled %>
      <%=  @pagy_my.series_nav(:bootstrap).html_safe%>
    </div>
  <% else %>
    <p style="color:#666;">You have no tasks assigned in this group.</p>
  <% end %>
</div>
