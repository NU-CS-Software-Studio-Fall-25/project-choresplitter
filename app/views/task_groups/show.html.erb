<div style="background:#fff; padding:20px 40px; border-radius:8px; box-shadow:0 4px 10px rgba(0,0,0,.1); max-width:800px; margin:40px auto;">
  <h2 style="margin:0 0 12px;">
    Task Group #<%= @task_group.id %>
    <small style="font-weight:normal; color:#666;">in <%= link_to @chore_group.name, chore_group_path(@chore_group) %></small>
  </h2>

  <!-- put task-group-specific fields here -->
  <p><strong>Name:</strong> <%= @task_group.try(:name) || "(unnamed)" %></p>
  <p><strong>Description:</strong> <%= @task_group.try(:description) || "—" %></p>

  <div style="margin-top:24px; display:flex; gap:12px;">
    <%= link_to "Back to this chore group", chore_group_path(@chore_group),
          style: "padding:8px 12px; border:1px solid #ddd; border-radius:6px; text-decoration:none; background:#f5f5f5; color:#333; font-weight:600;" %>
  </div>
</div>
