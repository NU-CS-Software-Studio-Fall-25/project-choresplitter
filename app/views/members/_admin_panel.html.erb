<!-- app/views/members/_admin_panel.html.erb -->

<h3 style="margin-top:24px;">Invite Members</h3>

<%= form_with url: chore_group_invitations_path(chore_group),
              method: :post,
              scope: :invitation,
              local: true,
              html: { style: "display:flex; gap:8px; align-items:center; margin-bottom:4px;" } do |f| %>

  <%= f.email_field :email,
        placeholder: "Enter user's email",
        required: true,
        style: "flex:1; padding:8px; border:1px solid #d1d5db; border-radius:6px;" %>

  <%= f.submit "Send Invite",
        style: "padding:8px 12px; border-radius:6px; border:1px solid #2563eb; background:#2563eb; color:white; font-weight:600; cursor:pointer;" %>
<% end %>

<% if flash[:invite_error].present? %>
  <p style="margin:4px 0 12px; color:#dc2626; font-size:0.875rem;">
    <%= flash[:invite_error] %>
  </p>
<% elsif flash[:invite_success].present? %>
  <p style="margin:4px 0 12px; color:#16a34a; font-size:0.875rem;">
    <%= flash[:invite_success] %>
  </p>
<% end %>

<h3 style="margin-top:24px;">Manage Members</h3>

<% if chore_group.active_members.any? %>
  <table style="width:100%; border-collapse:collapse; margin-top:8px;">
    <thead>
      <tr>
        <th style="text-align:left; padding:8px; border-bottom:1px solid #eee;">Name</th>
        <th style="text-align:left; padding:8px; border-bottom:1px solid #eee;">Email</th>
        <th style="text-align:left; padding:8px; border-bottom:1px solid #eee;">Role</th>
        <th style="padding:8px; border-bottom:1px solid #eee;">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% chore_group.active_members.includes(:user).each do |m| %>
        <tr>
          <td style="padding:8px; border-bottom:1px solid #f5f5f5;">
            <%= m.name.presence || m.user&.email_address || "Member ##{m.id}" %>
          </td>
          <td style="padding:8px; border-bottom:1px solid #f5f5f5;">
            <%= m.user&.email_address || "—" %>
          </td>
          <td style="padding:8px; border-bottom:1px solid #f5f5f5;">
            <%= m.try(:role) || (m.user_id == chore_group.try(:admin_id) ? "admin" : "member") %>
          </td>
          <td style="padding:8px; border-bottom:1px solid #f5f5f5; text-align:center;">
            <% is_admin_member = (m.try(:role) == 'admin') || (m.user_id == chore_group.try(:admin_id)) %>
            <% if is_admin_member %>
              <span style="font-size:12px; color:#6b7280;">(admin)</span>
            <% else %>
              <%= button_to "Kick",
                    [chore_group, m],
                    method: :delete,
                    form: { style: "display:inline" },
                    data: { confirm: "Remove this member from the group?" },
                    class: "kick-btn",
                    params: { tab: "admin" } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No members yet.</p>
<% end %>
