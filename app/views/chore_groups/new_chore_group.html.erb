<div style="background-color: white; padding: 40px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); width: 100%; max-width: 600px; margin: 40px auto; ">

  <h1 style="color: #000000ff; border-bottom: 1px solid #eee; padding-bottom: 15px; margin-top: 0; margin-bottom: 30px;">
    Create a New Chore Group
  </h1>

  <% if @chore_group.errors.any? %>
    <div id="error_explanation" style="background: #fdf2f2; border: 1px solid #f0c7c7; color: #a94442; padding: 15px; border-radius: 6px; margin-bottom: 20px;">
      <h2 style="margin: 0 0 10px; font-size: 1.1em; color: #a94442;"><%= pluralize(@chore_group.errors.count, "error") %> prohibited this group from being saved:</h2>
      <ul style="margin: 0; padding-left: 20px;">
        <% @chore_group.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <%= form_with model: @chore_group, local: true do |form| %>
    <div style="margin-bottom: 20px;">
      <%= form.label :name, "Group Name", style: "display: block; margin-bottom: 8px; color: #000000ff; font-weight: 500;" %><br>
      <%= form.text_field :name, required: true, 
            style: "width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; font-size: 16px;" %>
    </div>

    <div style="margin-bottom: 20px;">
    <%= form.label :admin_name, "Your Name in Group", style: "display: block; margin-bottom: 8px; color: #000000ff; font-weight: 500;" %><br>
    <%= form.text_field :admin_name, required: true, 
            style: "width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; font-size: 16px;" %>
    </div>

    <div style="margin-top: 30px;">
      <%= form.submit "Create Chore Group", 
            style: "width: 100%; padding: 12px; background-color: #4e73df; color: white; border: none; border-radius: 4px; font-size: 16px; font-weight: bold; cursor: pointer;" %>
    </div>
  <% end %>

</div>