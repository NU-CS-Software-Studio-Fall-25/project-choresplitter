<div style="color: #1e1e1eff; background:#fff; padding:20px 40px; border-radius:8px; box-shadow:0 4px 10px rgba(0,0,0,.1); width:80%; margin:40px auto;">
  <h2 style="margin:0 0 12px;"><%= @chore_group.name %></h2>
  <p><strong>Admin Name:</strong> <%= @chore_group.admin_name %></p>

    <% if @chore_group.respond_to?(:users) %>
    <h3 style="margin-top:24px;">Members</h3>
    <% if @chore_group.members.any? %>
    <ul>
        <% @chore_group.members.each do |m| %>
        <li><%= m.name.presence || m.user&.email_address || "Member ##{m.id}" %></li>
        <% end %>
    </ul>
    <% else %>
    <p>No members yet.</p>
    <% end %>
  <% end %>

  <h3 style="margin-top:24px;">Task Groups</h3>
  <% if @chore_group.task_groups.present? %>
    <ul style="list-style:none; padding:0; margin:0;">
      <%= render partial: "task_groups/card", collection: @chore_group.task_groups, as: :task_group %>
    </ul>
  <% else %>
    <p>No task groups yet.</p>
  <% end %>

  <h3 style="margin-top:24px;">Bills</h3>
  <%
    current_member =
      if defined?(Current) && Current&.user
        @chore_group.members.find_by(user_id: Current.user.id)
      end
    current_member ||= @chore_group.members.first
    bills_in_group = @chore_group.bills.includes(:member, bill_shares: :member)
    bills_you_paid = current_member ? bills_in_group.where(member_id: current_member.id) : Bill.none
    your_shares = if current_member
                    BillShare.joins(:bill)
                              .where(member_id: current_member.id, bills: { chore_group_id: @chore_group.id })
                  else
                    BillShare.none
                  end

    total_you_paid = bills_you_paid.sum(:total_amount)

    you_are_creditor_unpaid = BillShare
      .joins(:bill)
      .where(bills: { chore_group_id: @chore_group.id, member_id: current_member&.id })
      .where(status: 'unpaid')
      .where.not(member_id: current_member&.id)
      .sum(:amount)

    you_owe_unpaid = BillShare
      .joins(:bill)
      .where(member_id: current_member&.id, status: 'unpaid', bills: { chore_group_id: @chore_group.id })
      .where.not(bills: { member_id: current_member&.id })
      .sum(:amount)
  %>

  <div style="display:flex; gap:16px; flex-wrap:wrap;">
    <div style="flex:1 1 260px; border:1px solid #e5e7eb; border-radius:8px; padding:16px;">
      <div style="font-size:12px; color:#6b7280; text-transform:uppercase; letter-spacing:.04em;">You Paid (Total)</div>
      <div style="font-size:22px; font-weight:700; margin-top:6px;">
        <%= number_to_currency(total_you_paid || 0) %>
      </div>
    </div>

    <div style="flex:1 1 260px; border:1px solid #e5e7eb; border-radius:8px; padding:16px;">
      <div style="font-size:12px; color:#6b7280; text-transform:uppercase; letter-spacing:.04em;">Others Owe You (Unpaid)</div>
      <div style="font-size:22px; font-weight:700; margin-top:6px;">
        <%= number_to_currency(you_are_creditor_unpaid || 0) %>
      </div>
    </div>

    <div style="flex:1 1 260px; border:1px solid #e5e7eb; border-radius:8px; padding:16px;">
      <div style="font-size:12px; color:#6b7280; text-transform:uppercase; letter-spacing:.04em;">You Owe (Unpaid)</div>
      <div style="font-size:22px; font-weight:700; margin-top:6px;">
        <%= number_to_currency(you_owe_unpaid || 0) %>
      </div>
    </div>
  </div>

<div style="margin-top:16px; display:flex; gap:12px;">
  <%= link_to "Show details", chore_group_bills_path(@chore_group),
        style: "padding:8px 12px; border:1px solid #2563eb; color:#fff; background:#2563eb; border-radius:6px; text-decoration:none; font-weight:600;" %>

  <%= link_to "Create Bill", new_chore_group_bill_path(@chore_group),
        style: "padding:8px 12px; border:1px solid #e5e7eb; color:#111827; background:#fff; border-radius:6px; text-decoration:none; font-weight:600;" %>
</div>
 

  <div style="margin-top:24px;">
    <%= link_to "Back to groups", users_path,
          style: "padding:8px 12px; border:1px solid #ddd; border-radius:6px; text-decoration:none; background:#f5f5f5; color:#333; font-weight:600;" %>
  </div>
</div>

