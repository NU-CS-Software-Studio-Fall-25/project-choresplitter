<div style="background-color: white; padding: 40px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); width: 100%; max-width: 600px; margin: 40px auto;">

  <h2 style="color: #333; border-bottom: 1px solid #eee; padding-bottom: 15px; margin-top: 0; margin-bottom: 20px;">
    Found Chore Group
  </h2>

  <p style="line-height: 1.6; color: #333; font-size: 16px;">
    <strong style="color: #555; display: inline-block; width: 90px;">Name:</strong>
    <%= @found_group.name %><br>

    <strong style="color: #555; display: inline-block; width: 90px;">Code:</strong>
    <code style="padding:2px 6px; border:1px solid #e5e7eb; border-radius:4px; background:#f9fafb;">
      <%= @found_group.code %>
    </code><br>

    <strong style="color: #555; display: inline-block; width: 90px;">Admin:</strong>
    <%= @found_group.admin_name.presence || "(none)" %>
  </p>

  <div style="margin-top: 30px;">
    <% if @found_group.members.exists?(user_id: current_user.id) %>
      <em style="display:block; text-align:center; padding:15px; background-color:#f8f9fa; border:1px solid #dee2e6; color:#6c757d; border-radius:4px; font-style:normal;">
        You're already a member of this group.
      </em>
    <% else %>
      <%= form_with url: join_chore_group_path(@found_group), method: :post, local: true do %>
        <div style="margin-bottom: 20px;">
          <label style="display:block; font-weight:600; margin-bottom:6px;">Your Name</label>
          <%= text_field_tag :member_name, nil, placeholder: "e.g., John Doe",
                style: "width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; font-size: 16px;" %>
        </div>

        <%= submit_tag "Join this group",
              style: "width: 100%; padding: 12px; background-color: #28a745; color: white; border: none; border-radius: 4px; font-size: 16px; font-weight: bold; cursor: pointer;" %>
      <% end %>
    <% end %>
  </div>

</div>
