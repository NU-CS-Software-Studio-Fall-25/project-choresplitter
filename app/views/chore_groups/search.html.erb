<div style="background-color: white; padding: 40px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1); width: 100%; max-width: 600px; margin: 40px auto; font-family: sans-serif;">

  <h2 style="color: #333; border-bottom: 1px solid #eee; padding-bottom: 15px; margin-top: 0; margin-bottom: 20px;">
    Found Chore Group
  </h2>
  
  <p style="line-height: 1.6; color: #333; font-size: 16px;">
    <strong style="color: #555; display: inline-block; width: 80px;">Name:</strong> <%= @found_group.name %><br>
    <strong style="color: #555; display: inline-block; width: 80px;">ID:</strong> <%= @found_group.id %><br>
    <strong style="color: #555; display: inline-block; width: 80px;">Admin:</strong> <%= @found_group.admin.name || "(none)" %>
  </p>

  <div style="margin-top: 30px;">
    <% if @found_group.users.exists?(current_user.id) %>
      <em style="display: block; text-align: center; padding: 15px; background-color: #f8f9fa; border: 1px solid #dee2e6; color: #6c757d; border-radius: 4px; font-style: normal;">
        You're already a member of this group.
      </em>
    <% else %>
      <%# This form replaces button_to to allow for direct inline styling %>
      <%= form_with url: join_chore_group_path(@found_group.id), method: :post do |form| %>
        <%= form.submit "Join this group", 
              style: "width: 100%; padding: 12px; background-color: #28a745; color: white; border: none; border-radius: 4px; font-size: 16px; font-weight: bold; cursor: pointer;" %>
      <% end %>
    <% end %>
  </div>
  
</div>